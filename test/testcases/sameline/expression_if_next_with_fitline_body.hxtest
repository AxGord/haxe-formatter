---

class Main {
	static function test():Void {
		final x:Float = if (a > b)
			-(a - b)
		else if (a < b)
			-(b - a)
		else
			0;
		return if (difference > 0)
			1
		else if (difference < 0)
			-1
		else
			0;
	}
}
