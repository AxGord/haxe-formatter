	"wrapping": {"maxLineLength": 140,
		"conditionWrapping": {"defaultWrap": "fillLineWithLeadingBreak", "rules": [
			{"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}], "type": "noWrap"}
		]}
	},
	"sameLine": {"ifBody": "fitLine"}
}

