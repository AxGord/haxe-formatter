class Main {
	static function main() {
		if (checkDetailEntriesForProcessing(detailEntry, lostEntry)
			&& !result.exists((u:DataModelDetailItemUser) ->
				(u.id != 0 && u.id == detailEntry.id) || u.email == detailEntry.email
			)) {
			doSomething();
		}
	}
}
