{
	"wrapping": {
		"maxLineLength": 120,
		"expressionWrapping": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

---

class Main {
	static function main() {
		if (checkDetailEntriesForProcessing(detailEntry, lostEntry) && !result.exists((u:DataModelDetailItemUser) -> (u.id != 0 && u.id == detailEntry.id) || u.email == detailEntry.email)) {
			doSomething();
		}
	}
}

