---

class Main {
	static function main() {
		var result = items.filter(ShareUtil.notMixed).map(u -> {email: u.email, canEdit: u.access == EDIT});
	}
}

---

class Main {
	static function main() {
		var result = items.filter(ShareUtil.notMixed)
			.map(u -> {email: u.email, canEdit: u.access == EDIT});
	}
}
