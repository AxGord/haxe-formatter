---

class Main {
	static function main() {
		var result = items.filter(Validator.notEmpty).map(x -> {value: x.value, enabled: x.status == OPEN});
	}
}

---

class Main {
	static function main() {
		var result = items.filter(Validator.notEmpty)
			.map(x -> {value: x.value, enabled: x.status == OPEN});
	}
}
