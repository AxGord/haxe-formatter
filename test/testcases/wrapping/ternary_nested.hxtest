{
	"wrapping": {
		"maxLineLength": 100,
		"ternaryExpression": {
			"defaultWrap": "noWrap",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}],
					"type": "onePerLineAfterFirst",
					"location": "beforeLast"
				}
			]
		}
	}
}

---

class Main {
	static function test():Void {
		x = indentX + (item.folder ? Dimensions.ITEM_ICON : !fixedSearch ? Dimensions.ITEM_ICON : Dimensions.ITEM_ICON_FIXED_FILE_SEARCH);
		y = cond ? shortA : shortB;
	}
}

---

class Main {
	static function test():Void {
		x = indentX
			+ (item.folder
				? Dimensions.ITEM_ICON
				: !fixedSearch ? Dimensions.ITEM_ICON : Dimensions.ITEM_ICON_FIXED_FILE_SEARCH);
		y = cond ? shortA : shortB;
	}
}
