{
	"wrapping": {
		"maxLineLength": 80,
		"conditionWrapping": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

---

class Main {
	static function main() {
		while (conditionAlpha && conditionBravo && conditionCharlie && conditionDelta && conditionEcho) {
			doSomething();
		}
		while (shortCond) {
			doSomething();
		}
	}
}

---

class Main {
	static function main() {
		while (
			conditionAlpha
			&& conditionBravo
			&& conditionCharlie
			&& conditionDelta
			&& conditionEcho
		) {
			doSomething();
		}
		while (shortCond) {
			doSomething();
		}
	}
}
