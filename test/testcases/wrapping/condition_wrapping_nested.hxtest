{
	"wrapping": {
		"maxLineLength": 80,
		"conditionWrapping": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		},
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

---

class Main {
	static function main() {
		if (!list.exists((item:FileSystemItemData) -> path.startsWith(item.filePath + '/'))) {
			doSomething();
		}
		if (shortCond) {
			doSomething();
		}
	}
}

---

class Main {
	static function main() {
		if (!list.exists(
			(item:FileSystemItemData) -> path.startsWith(item.filePath + '/')
		)) {
			doSomething();
		}
		if (shortCond) {
			doSomething();
		}
	}
}
