class Main {
	static function main() {
		switch (1) {
			case 1:
				if (true) {
					final selected:Int = 1;
					final level:Int = 2;
					final selectedParent:Int = 3;
					_fileList.selectedItemPath = !groupByOwner && level == 2 && selectedParent != null ? selectedParent.filePath : selected.filePath;
				}
		}
	}
}

