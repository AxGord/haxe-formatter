---

class Main {
	static function main() {
		switch (1) {
			case 1:
				if (true) {
					final resolved:Int = 1;
					final level:Int = 2;
					final resolvedParent:Int = 3;
					_viewList.currentEntryPath = !sortByColumn && level == 2 && resolvedParent != null ? resolvedParent.nodePath : resolved.nodePath;
				}
		}
	}
}

