{
	"emptyLines": {
		"classEmptyLines": {
			"beginType": 0,
			"endType": 0
		}
	},
	"wrapping": {
		"maxLineLength": 100,
		"opBoolChain": {
			"defaultWrap": "noWrap",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				},
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}],
					"type": "fillLine",
					"location": "afterLast"
				}
			]
		},
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

---

class Main {
	function test():Array<Bool> {
		return [
			check(
				folder.lockForSessionsPaths != null &&
				folder.lockForSessionsPaths.contains('/session1.ses') &&
				folder.lockForSessionsPaths.contains('/session2.ses'),
				"folder should have both session locks"
			)
		];
	}
}

