{
	"indentation": {"tabWidth": 4},
	"wrapping": {
		"maxLineLength": 100,
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}], "type": "noWrap"}
			]
		},
		"opBoolChain": {
			"defaultWrap": "noWrap",
			"rules": [
				{"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}], "type": "fillLine", "location": "afterLast"}
			]
		}
	}
}

---

class Main {
	static function main() {
		if (conditionAlpha && functionWithManyParams(longParameterA, longParameterB, longParameterC, longParameterD) && conditionBravo) {
			doWork();
		}
	}
}

---

class Main {
	static function main() {
		if (conditionAlpha
			&& functionWithManyParams(longParameterA, longParameterB, longParameterC, longParameterD)
			&& conditionBravo) {
			doWork();
		}
	}
}
