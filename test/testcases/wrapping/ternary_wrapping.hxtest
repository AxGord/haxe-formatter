{
	"wrapping": {
		"maxLineLength": 120,
		"ternaryExpression": {
			"defaultWrap": "noWrap",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}],
					"type": "onePerLineAfterFirst",
					"location": "beforeLast"
				}
			]
		},
		"opBoolChain": {
			"defaultWrap": "noWrap",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}],
					"type": "onePerLineAfterFirst",
					"location": "afterLast"
				}
			]
		},
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

