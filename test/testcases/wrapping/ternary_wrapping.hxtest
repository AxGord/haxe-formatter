		final x:Int = cond ? 1 : 2;
		return a != null && a.length != 0 ? doSomethingLong(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q) : false;
		final y:Int = obj.lastIndexOf('/') != -1 ? createLongFunctionCall(paramA, paramB, paramC, paramD, paramE) : defaultValue;
