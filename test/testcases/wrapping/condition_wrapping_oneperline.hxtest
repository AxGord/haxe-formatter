{
	"wrapping": {
		"maxLineLength": 80,
		"conditionWrapping": {
			"defaultWrap": "onePerLineAfterFirst",
			"defaultLocation": "beforeLast",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

---

class Main {
	static function main() {
		if (conditionAlpha && conditionBravo && conditionCharlie && conditionDelta) {
			doSomething();
		}
		if (shortCond) {
			doSomething();
		}
	}
}

---

class Main {
	static function main() {
		if (conditionAlpha
			&& conditionBravo
			&& conditionCharlie
			&& conditionDelta) {
			doSomething();
		}
		if (shortCond) {
			doSomething();
		}
	}
}
