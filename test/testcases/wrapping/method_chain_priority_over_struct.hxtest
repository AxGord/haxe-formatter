---

class Main {
	static function main() {
		final a:GenericRecordBatchPayload = {
			firstField: holder.firstField != null ? holder.firstField.inner.filter(Validator.notEmpty)
				.map(x -> {value: x.value, enabled: x.status == OPEN })
				.concat(holder.firstField.lateral.filter(Validator.notEmpty)
					.map(x -> {value: x.value, enabled: x.status == OPEN })) : null,
		};
	}
}

---

class Main {
	static function main() {
		final a:GenericRecordBatchPayload = {
			firstField: holder.firstField != null
				? holder.firstField.inner.filter(Validator.notEmpty)
					.map(x -> {value: x.value, enabled: x.status == OPEN})
					.concat(
						holder.firstField.lateral.filter(Validator.notEmpty)
							.map(x -> {value: x.value, enabled: x.status == OPEN})
					)
				: null,
		};
	}
}
