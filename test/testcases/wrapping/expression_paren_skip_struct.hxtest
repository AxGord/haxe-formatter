		return {
			coach: [
				for (user in users)
					if (!added.exists((u:CoachUser) -> u.email == user.Email)) ({
						firstname: user.Firstname,
						lastname: user.Lastname,
						id: user.UserId,
						email: user.Email,
						access: VIEW,
						image: user.Image
