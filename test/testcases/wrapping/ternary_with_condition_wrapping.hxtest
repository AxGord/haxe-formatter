{
	"wrapping": {
		"maxLineLength": 100,
		"conditionWrapping": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}], "type": "noWrap"}
			]
		},
		"ternaryExpression": {
			"defaultWrap": "noWrap",
			"rules": [
				{"conditions": [{"cond": "exceedsMaxLineLength", "value": 1}], "type": "onePerLineAfterFirst", "location": "beforeLast"}
			]
		}
	}
}

---

class Main {
	static function main() {
		final result:String = conditionAlpha && conditionBravo && conditionCharlie ? "longResultValueAlpha" : "longFallbackValueBravo";
	}
}

---

class Main {
	static function main() {
		final result:String = conditionAlpha && conditionBravo && conditionCharlie
			? "longResultValueAlpha"
			: "longFallbackValueBravo";
	}
}
