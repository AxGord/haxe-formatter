		_storedVal.targetItem = [ for (firstGroupItem in someStore.firstGroups.items)
			if (counterVarX1++ < BBBBB_PRINT_LIMITSA) firstGroupItem.name
		].concat(
			[ for (secondNode in someStore.bGroups.items) if (counterVarX1++ < BBBBB_PRINT_LIMITSA) secondNode.name ]
