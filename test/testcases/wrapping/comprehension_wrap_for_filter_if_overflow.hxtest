{
	"emptyLines": {
		"classEmptyLines": {
			"beginType": 0,
			"endType": 0
		}
	},
	"wrapping": {
		"maxLineLength": 140,
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				},
				{
					"conditions": [{"cond": "itemCount <= n", "value": 1}, {"cond": "totalItemLength <= n", "value": 100}],
					"type": "noWrap"
				}
			]
		}
	},
	"sameLine": {
		"ifBody": "fitLine",
		"forBody": "fitLine",
		"whileBody": "fitLine",
		"functionBody": "fitLine",
		"expressionIf": "next",
		"comprehensionFor": "fitLine"
	}
}

---

class C {
	function f() {
		var counterVarX1:UInt = 0;
		_storedVal.targetItem = [ for (firstGroupItem in someStore.firstGroups.items) if (counterVarX1++ < BBBBB_PRINT_LIMITSA) firstGroupItem.name ].concat(
			[ for (secondNode in someStore.bGroups.items) if (counterVarX1++ < BBBBB_PRINT_LIMITSA) secondNode.name ]
		).join('\n');
	}
}

