---

class Main {
	static function test():Void {
		!outer.exists((s:ShareUser) -> !inner.exists((d:ShareUser) -> (d.id != 0 && d.id == s.id) || d.email == s.email));
		list.filter((item:Item) -> item.name == name);
	}
}

---

class Main {
	static function test():Void {
		!outer.exists((s:ShareUser) ->
			!inner.exists((d:ShareUser) -> (d.id != 0 && d.id == s.id) || d.email == s.email)
		);
		list.filter((item:Item) -> item.name == name);
	}
}
