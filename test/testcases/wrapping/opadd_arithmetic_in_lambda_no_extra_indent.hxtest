{
	"emptyLines": {
		"classEmptyLines": {
			"beginType": 0,
			"endType": 0
		}
	},
	"wrapping": {
		"maxLineLength": 100,
		"callParameter": {
			"defaultWrap": "fillLineWithLeadingBreak",
			"rules": [
				{
					"conditions": [{"cond": "exceedsMaxLineLength", "value": 0}],
					"type": "noWrap"
				}
			]
		}
	}
}

---

class Main {
	function test():Bool {
		return data.childExists(item -> item.path.length + delta > maxLength || hasLongPath(delta, item));
	}
}

---

class Main {
	function test():Bool {
		return data.childExists(
			item -> item.path.length + delta > maxLength || hasLongPath(delta, item)
		);
	}
}
